{
  "name": "@monkeytype/backend",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint . --type-aware --type-check",
    "build": "wrangler deploy --dry-run --outdir dist",
    "ts-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev --port 5005 --env-file dev.env",
    "seed": "node scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@monkeytype/contracts": "workspace:*",
    "@monkeytype/schemas": "workspace:*",
    "@monkeytype/util": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "jose": "6.2.17",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.1",
    "@cloudflare/workers-types": "5.20261109.1",
    "@monkeytype/oxlint-config": "workspace:*",
    "@monkeytype/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
